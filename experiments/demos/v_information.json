{
  "data": {"generator": "waveform"},
  "spec": {
    "series_length": 64,
    "context_max": 32,
    "horizon": 16,
    "patch_size": 8,
    "context_lengths": [16, 32]
  },
  "model": {
    "d_model": 64,
    "num_layers": 1,
    "max_seq_len": 16,
    "patch_sizes": [8],
    "components": ["student_t", "normal_fixed", "log_normal"]
  },
  "train": {
    "n_windows": 64,
    "batch_size": 8,
    "warmup_steps": 1,
    "lr": 0.0003,
    "checkpoint_fractions": [0.5, 1.0],
    "heldout_first_seed": 1000,
    "heldout_windows": 32,
    "eval_batch_size": 8,
    "precision": "fp32",
    "eval_precision": "fp32",
    "device": "cpu",
    "fused_adam": false,
    "log_every": 4
  },
  "estimator": "v_information",
  "estimator_config": {
    "test_first_seed": 2000,
    "test_windows": 32
  }
}
