# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Sphinx documentation (built into public/ by .github/workflows/docs.yaml)
public/
doc/_build/

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# Linters / type checkers
.ruff_cache/
.mypy_cache/

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.venv
env/
venv/

# Runtime artifacts (never commit weights/results)
results/
logs/
checkpoints/
runs/

# LaTeX (paper/, slides/, notes/)
*.aux
*.log
*.bbl
*.blg
*.out
*.toc
# macOS
.DS_Store
